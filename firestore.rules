rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function hasActiveAccess() {
      return signedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.active == true &&
          (!get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.validFrom || get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.validFrom <= request.time) &&
          (!get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.validUntil || get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.validUntil >= request.time)
        )
      );
    }
    function hasActiveAccessFor(userId) {
      return (userId == request.auth.uid && isAdmin()) || (
        exists(/databases/$(database)/documents/users/$(userId)/access/meta) &&
        get(/databases/$(database)/documents/users/$(userId)/access/meta).data.active == true &&
        (!get(/databases/$(database)/documents/users/$(userId)/access/meta).data.validFrom || get(/databases/$(database)/documents/users/$(userId)/access/meta).data.validFrom <= request.time) &&
        (!get(/databases/$(database)/documents/users/$(userId)/access/meta).data.validUntil || get(/databases/$(database)/documents/users/$(userId)/access/meta).data.validUntil >= request.time)
      );
    }
    function chatParticipant(data) {
      return signedIn() && data.participantIds is list && request.auth.uid in data.participantIds;
    }
    function validChatParticipants(data) {
      return data.participantIds is list && data.participantIds.size() == 2 &&
        request.auth.uid in data.participantIds &&
        hasActiveAccessFor(data.participantIds[0]) && hasActiveAccessFor(data.participantIds[1]);
    }

    match /catalog/{itemId} {
      allow read: if hasActiveAccess();
      allow create, update, delete: if isAdmin();
    }
    match /users/{userId}/data/{docId} {
      allow read, write: if signedIn() && request.auth.uid == userId && hasActiveAccess();
    }
    match /users/{userId}/access/{docId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /accessKeys/{keyId} { allow read, write: if false; }
    match /settings/public {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 사용자 프로필: 프로필 원문은 본인만 직접 읽고 쓸 수 있으며,
    // 다른 사용자 목록은 서버 API가 이용권 상태를 확인한 뒤 제공합니다.
    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && hasActiveAccess();
    }

    // 1:1 사용자 채팅. 대화 ID는 두 UID를 정렬해 만든 값을 사용합니다.
    match /chats/{chatId} {
      allow read: if hasActiveAccess() && validChatParticipants(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if hasActiveAccess() && validChatParticipants(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
