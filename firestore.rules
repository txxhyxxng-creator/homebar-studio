rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasActiveAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.validFrom <= request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/access/meta).data.validUntil >= request.time;
    }

    match /catalog/{itemId} {
      allow read: if hasActiveAccess() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/data/{docId} {
      allow read, write: if signedIn() && request.auth.uid == userId && (hasActiveAccess() || isAdmin());
    }

    // 이용 권한 문서는 서버(Admin SDK)만 수정합니다.
    match /users/{userId}/access/{docId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // 이용 키 원문/해시는 클라이언트에 직접 노출하지 않습니다.
    match /accessKeys/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
